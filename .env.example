# LedgerCore API
DATABASE_URL=postgresql+psycopg://ledgercore:change-me@localhost:5432/ledgercore
PAYMENT_PROVIDER=razorpay

# Razorpay (sandbox credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree (sandbox credentials)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_ENV=sandbox

# PayU (sandbox credentials)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=sandbox
PAYU_SUCCESS_URL=https://your-public-domain.example/api/v1/payments/payu/success
PAYU_FAILURE_URL=https://your-public-domain.example/api/v1/payments/payu/failure

# Webhook secret encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPTION_KEY=

# Aggregator
AGGREGATOR_BASE_URL=http://localhost:8100
AGGREGATOR_REDIS_URL=redis://localhost:6379/1
GATEWAY_METRICS_REFRESH_SECONDS=5
MAX_RETRIES=2
MERCHANT_LATENCY_BUDGET_MS=10000

# Shared event pipeline
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=payment.attempt.events

# Metrics service
METRICS_REDIS_URL=redis://localhost:6379/1
METRICS_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/payment_metrics
KAFKA_METRICS_TOPIC=payment.attempt.events
KAFKA_METRICS_GROUP=payment-metrics-consumer

# Local-only dedicated test database (never use production credentials here).
TEST_POSTGRES_PASSWORD=ledgercore_test_password
TEST_DATABASE_URL=postgresql+psycopg://ledgercore_test:ledgercore_test_password@localhost:5433/ledgercore_test
