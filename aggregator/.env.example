# Razorpay credentials: use the same sandbox credentials as LedgerCore.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=10

# Simulated gateway behavior.
# Modes: success, fail, timeout
MOCK_ALPHA_MODE=success
MOCK_ALPHA_DELAY_MS=0

MOCK_BETA_MODE=fail
MOCK_BETA_DELAY_MS=0

MOCK_GAMMA_MODE=success
MOCK_GAMMA_DELAY_MS=500

MOCK_DELTA_MODE=timeout
MOCK_DELTA_DELAY_MS=0
