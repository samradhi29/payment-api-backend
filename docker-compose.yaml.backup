services:
  db:
    image: postgres:17-alpine
    container_name: ledgercore-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ledgercore
      POSTGRES_USER: ledgercore
      POSTGRES_PASSWORD: ledgercore_dev_password
    ports:
      - "5432:5432"
    volumes:
      - ledgercore_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ledgercore -d ledgercore"]
      interval: 5s
      timeout: 5s
      retries: 5

  test-db:
    image: postgres:17-alpine
    container_name: ledgercore-test-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ledgercore_test
      POSTGRES_USER: ledgercore_test
      POSTGRES_PASSWORD: ledgercore_test_password
    volumes:
      - ledgercore_test_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ledgercore_test -d ledgercore_test"]
      interval: 5s
      timeout: 5s
      retries: 5

  api:
    build: .
    container_name: ledgercore-api
    restart: unless-stopped
    ports:
      - "8000:8000"
    env_file:
      - .env
    environment:
      DATABASE_URL: postgresql+psycopg://ledgercore:ledgercore_dev_password@db:5432/ledgercore
    volumes:
      - ./app:/app/app
    depends_on:
      db:
        condition: service_healthy

  worker:
    build: .
    container_name: ledgercore-worker
    restart: unless-stopped
    command: python -m app.workers.run_outbox_worker
    env_file:
      - .env
    environment:
      DATABASE_URL: postgresql+psycopg://ledgercore:ledgercore_dev_password@db:5432/ledgercore
    volumes:
      - ./app:/app/app
    depends_on:
      db:
        condition: service_healthy

volumes:
  ledgercore_data:
  ledgercore_test_data: